generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  cpf       String?
  conselho  String?
  perfil    String   @default("tecnico")
  ativo     Boolean  @default(true)
  termosAceitosEm DateTime?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tarefas        Tarefa[]
  logs           LogAuditoria[]
  responsaveis   Responsavel[]
  alertas        Alerta[]
  historicos     Historico[]
}

model Cliente {
  id          Int      @id @default(autoincrement())
  apelido     String
  razaoSocial String
  nomeFantasia String?
  cnpj        String   @unique
  ativo       Boolean  @default(true)
  visibilidade String  @default("publico")
  rua         String?
  numero      String?
  bairro      String?
  complemento String?
  cep         String?
  municipio   String?
  uf          String?
  telefone    String
  email       String
  respLegal   String

  // --- PGRS fields (merged from Empresa) ---
  ramoAtividade             String?
  indicacaoFiscal           String?
  diasFuncionamento         String?
  horariosFuncionamento     String?
  areaConstruida            String?
  porteColaboradores        String?
  possuiRefeitorio          Boolean?
  refeicoesDiarias          String?
  unidadesDia               String?
  preparoRefeicoes          String?
  responsavelTecnicoNome    String?
  responsavelTecnicoConselho String?
  responsavelTecnicoCpf     String?
  responsavelPgrsNome       String?
  responsavelPgrsCargo      String?
  tags                      String[] @default([])
  latitude                  Float?
  longitude                 Float?
  inscricaoEstadual         String?
  numeroColaboradores       String?
  representanteLegalNome    String?
  responsavelGestao1Nome    String?
  responsavelGestao1Telefone String?
  responsavelGestao1Email   String?
  responsavelGestao2Nome    String?
  responsavelGestao2Telefone String?
  responsavelGestao2Email   String?
  representanteLegalCpf     String?
  responsavelTecnicoEstabelecimentoNome    String?
  responsavelTecnicoEstabelecimentoEmail   String?
  responsavelTecnicoEstabelecimentoOrgao   String?
  responsavelTecnicoEstabelecimentoRegistro String?
  tipoServicosDescricao                    String?
  atendimentosDia                          String?
  responsavelElaboracaoNome     String?
  responsavelElaboracaoCpf      String?
  responsavelElaboracaoEndereco String?
  responsavelElaboracaoBairro   String?
  responsavelElaboracaoEmail    String?
  responsavelElaboracaoTelefone String?
  responsavelElaboracaoEmpresaNome String?
  responsavelElaboracaoEmpresaCnpj String?
  responsavelElaboracaoRegistroCrq String?

  criadoEm    DateTime @default(now())
  updatedAt DateTime @updatedAt

  empreendimentos Empreendimento[]
  financeiros     Financeiro[]
  residuos            ResiduoItem[]
  residuosAnuais      ResiduoAnual[]
  empresasContratadas EmpresaContratada[]
  documentosGerados   DocumentoGerado[]
  documentos          Documento[]
  historicos          Historico[]
  acessos             Acesso[]
  contratos           Contrato[]
  propostas           Proposta[]
}

model Empreendimento {
  id          Int      @id @default(autoincrement())
  apelido     String
  ativo       Boolean  @default(true)
  visibilidade String  @default("publico")
  cnpj        String?
  cep         String?
  municipio   String?
  uf          String?
  rua         String?
  numero      String?
  bairro      String?
  complemento String?
  descricao   String
  latitude    Float?
  longitude   Float?
  utmX        Float?
  utmY        Float?
  utmZona     Int?
  utmHemisferio String?
  poligono    String?
  clienteId   Int
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente   Cliente      @relation(fields: [clienteId], references: [id])
  processos Processo[]
  controleDmr ControleDmr?
  historicos Historico[]
  acessos    Acesso[]
  contratos Contrato[]
  propostas Proposta[]
}

model Orgao {
  id     Int    @id @default(autoincrement())
  nome   String
  sigla  String @unique

  processos Processo[]
}

model Contrato {
  id                  Int      @id @default(autoincrement())
  clienteId           Int
  servicoProcesso     String
  dataAssinatura      DateTime
  dataValidade        DateTime
  alertaRenovacaoDias Int      @default(60)
  ativo               Boolean  @default(true)
  empreendimentoId    Int?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id])
}

model Processo {
  id              Int      @id @default(autoincrement())
  tipo            String
  ativo           Boolean  @default(true)
  orgaoId         Int
  sistema         String
  numProtocolo    String
  status          String   @default("protocolado")
  validade        DateTime?
  empreendimentoId Int
  responsavelId   Int?
  observacoes     String?
  numLicenca      String?
  condicionantes  String?
  dataProtocolo   DateTime?
  dataContato     DateTime?
  alertaDias      Int         @default(30)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  orgao         Orgao          @relation(fields: [orgaoId], references: [id])
  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  responsavel   Responsavel?   @relation(fields: [responsavelId], references: [id])
  exigencias    Exigencia[]
  documentos    Documento[]
  timeline      TimelineProcesso[]
  autorizacaoCorte AutorizacaoCorte?
}

model AutorizacaoCorte {
  id                   Int      @id @default(autoincrement())
  processoId           Int      @unique
  processo             Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  quantidadeIndividuos Int?

  compensacaoExigida   Boolean   @default(false)
  tipoCompensacao      String?
  quantidadeMudas      Int?
  areaCompensacaoM2    Float?
  prazoCompensacao     DateTime?
  statusCompensacao    String    @default("pendente")
  comprovante          String?

  exigenciaId          Int?

  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt
}

model Exigencia {
  id               Int      @id @default(autoincrement())
  descricao        String
  ativo            Boolean  @default(true)
  prazo            DateTime
  antecedenciaDias Int      @default(7)
  cumprida         Boolean  @default(false)
  processoId       Int
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  processo   Processo    @relation(fields: [processoId], references: [id])
  documentos Documento[]
}

model Documento {
  id          Int      @id @default(autoincrement())
  nome        String
  tipo        String
  ativo       Boolean  @default(true)
  caminho     String
  tamanho     Int
  processoId  Int?
  exigenciaId Int?
  clienteId   Int?
  criadoEm    DateTime @default(now())

  processo  Processo?  @relation(fields: [processoId], references: [id])
  exigencia Exigencia? @relation(fields: [exigenciaId], references: [id])
  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
}

model TimelineProcesso {
  id          Int      @id @default(autoincrement())
  status      String
  descricao   String?
  criadoEm    DateTime @default(now())
  processoId  Int
  usuarioId   Int?

  processo Processo @relation(fields: [processoId], references: [id])
}

model Responsavel {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String
  telefone  String?
  funcao    String
  cargaHoras Int     @default(0)
  usuarioId Int?
  criadoEm  DateTime @default(now())

  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])
  processos Processo[]
  tarefas   Tarefa[]
}

model Tarefa {
  id             Int      @id @default(autoincrement())
  titulo         String
  descricao      String?
  ativo          Boolean  @default(true)
  status         String   @default("pendente")
  prioridade     String   @default("media")
  dataVencimento DateTime?
  statusObs      String?
  responsavelId  Int
  usuarioId      Int
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  responsavel Responsavel @relation(fields: [responsavelId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
}

model Financeiro {
  id              Int      @id @default(autoincrement())
  tipoCobranca    String
  valor           Float
  ativo           Boolean  @default(true)
  formaPagamento  String
  statusPagamento String   @default("pendente")
  dataVencimento  DateTime?
  dataPagamento   DateTime?
  descricao       String?
  clienteId       Int
  processoId      Int?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  cliente Cliente   @relation(fields: [clienteId], references: [id])
}

model LogAuditoria {
  id        Int      @id @default(autoincrement())
  acao      String
  entidade  String
  entidadeId Int
  dados     String?
  usuarioId Int?
  criadoEm  DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model Alerta {
  id          Int      @id @default(autoincrement())
  titulo      String
  mensagem    String
  tipo        String
  lido        Boolean  @default(false)
  dataDisparo DateTime?
  processoId  Int?
  usuarioId   Int?
  criadoEm    DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model EmpresaConfig {
  id          Int     @id @default(autoincrement())
  razaoSocial String
  nomeFantasia String?
  cnpj        String?
  rua         String?
  numero      String?
  bairro      String?
  complemento String?
  cep         String?
  municipio   String?
  uf          String?
  telefone    String?
  email       String?
  website     String?
  logo        String?
}

model ResiduoItem {
  id        Int     @id @default(autoincrement())
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  categoria String
  ordem     Int

  pontoGeracao     String?
  residuosGerados  String?
  quantificacao    String?
  acondicionamento String?
  armazenamento    String?
  coletaInterna    String?
  empresaTransporte      String?
  empresaDisposicaoFinal String?
}

model ResiduoAnual {
  id        Int     @id @default(autoincrement())
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  categoria String
  ordem     Int

  pontoGeracao          String?
  residuo               String?
  estadoFisico          String?
  codIbama              String?
  classificacaoResiduo  String?
  codigoNbr10004        String?
  codigoConamaLgr       String?
  entrada               String?
  geracaoAnual          String?
  acondicionamento      String?
  transportadora        String?
  tratamento            String?
  destino               String?
}

model EmpresaContratada {
  id        Int     @id @default(autoincrement())
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  ordem                     Int
  nomeFantasia              String?
  razaoSocial               String?
  cnpj                      String?
  numeroDataValidadeLicenca String?
}

model ControleDmr {
  id              Int      @id @default(autoincrement())
  empreendimentoId Int     @unique
  ano             Int
  t1Dmr           String   @default("")
  t1Mtr           String   @default("")
  t2Dmr           String   @default("")
  t2Mtr           String   @default("")
  t3Dmr           String   @default("")
  t3Mtr           String   @default("")
  t4Dmr           String   @default("")
  t4Mtr           String   @default("")
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
}

model DocumentoGerado {
  id           Int      @id @default(autoincrement())
  clienteId    Int
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  templateSlug String
  dadosSnapshot Json
  createdAt    DateTime @default(now())
}

model Configuracao {
  id Int @id @default(autoincrement())

  nomeEmpresa String?
  cnpj        String?
  registroCrq String?
  registroOrgao String?

  responsavelNome      String?
  responsavelCpf       String?
  responsavelEndereco  String?
  responsavelBairro    String?
  responsavelEmail     String?
  responsavelTelefone  String?

  atualizadoEm DateTime @updatedAt
}

model Historico {
  id              Int      @id @default(autoincrement())
  descricao       String
  anexo           String?
  clienteId       Int?
  empreendimentoId Int?
  usuarioId       Int?
  criadoEm        DateTime @default(now())

  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id])
  usuario      Usuario?      @relation(fields: [usuarioId], references: [id])
}

model Acesso {
  id              Int      @id @default(autoincrement())
  login           String
  senha           String
  descricao       String
  clienteId       Int?
  empreendimentoId Int?
  criadoEm        DateTime @default(now())

  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id])
}

model Proposta {
  id              Int      @id @default(autoincrement())
  titulo          String
  clienteId       Int
  empreendimentoId Int?
  valor           Float?
  status          String   @default("rascunho")
  validadeDias    Int      @default(30)
  servicos        Json?
  observacoes     String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id])
}
