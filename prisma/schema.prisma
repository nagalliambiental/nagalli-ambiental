generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int            @id @default(autoincrement())
  nome            String
  email           String         @unique
  senha           String
  perfil          String         @default("tecnico")
  ativo           Boolean        @default(true)
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  cpf             String?
  conselho        String?
  termosAceitosEm DateTime?
  alertas         Alerta[]
  backups         Backup[]
  historicos      Historico[]
  logs            LogAuditoria[]
  responsaveis    Responsavel[]
  tarefas         Tarefa[]
}

model Cliente {
  id                                        Int                 @id @default(autoincrement())
  apelido                                   String
  razaoSocial                               String
  cnpj                                      String              @unique
  telefone                                  String
  email                                     String
  respLegal                                 String
  criadoEm                                  DateTime            @default(now())
  updatedAt                                 DateTime            @updatedAt
  nomeFantasia                              String?
  cep                                       String?
  municipio                                 String?
  uf                                        String?
  rua                                       String?
  numero                                    String?
  bairro                                    String?
  complemento                               String?
  ramoAtividade                             String?
  indicacaoFiscal                           String?
  diasFuncionamento                         String?
  horariosFuncionamento                     String?
  areaConstruida                            String?
  porteColaboradores                        String?
  possuiRefeitorio                          Boolean?
  refeicoesDiarias                          String?
  unidadesDia                               String?
  preparoRefeicoes                          String?
  responsavelPgrsNome                       String?
  responsavelPgrsCargo                      String?
  tags                                      String[]            @default([])
  latitude                                  Float?
  longitude                                 Float?
  inscricaoEstadual                         String?
  numeroColaboradores                       String?
  representanteLegalNome                    String?
  responsavelGestao1Nome                    String?
  responsavelGestao1Telefone                String?
  responsavelGestao1Email                   String?
  responsavelGestao2Nome                    String?
  responsavelGestao2Telefone                String?
  responsavelGestao2Email                   String?
  representanteLegalCpf                     String?
  responsavelTecnicoEstabelecimentoNome     String?
  responsavelTecnicoEstabelecimentoEmail    String?
  responsavelTecnicoEstabelecimentoOrgao    String?
  responsavelTecnicoEstabelecimentoRegistro String?
  tipoServicosDescricao                     String?
  atendimentosDia                           String?
  responsavelElaboracaoNome                 String?
  responsavelElaboracaoCpf                  String?
  responsavelElaboracaoEndereco             String?
  responsavelElaboracaoBairro               String?
  responsavelElaboracaoEmail                String?
  responsavelElaboracaoTelefone             String?
  responsavelElaboracaoEmpresaNome          String?
  responsavelElaboracaoEmpresaCnpj          String?
  responsavelElaboracaoRegistroCrq          String?
  ativo                                     Boolean             @default(true)
  responsavelTecnicoNome                    String?
  responsavelTecnicoConselho                String?
  responsavelTecnicoCpf                     String?
  visibilidade                              String              @default("publico")
  acessos                                   Acesso[]
  contratos                                 Contrato[]
  documentos                                Documento[]
  documentosGerados                         DocumentoGerado[]
  empreendimentos                           Empreendimento[]
  empresasContratadas                       EmpresaContratada[]
  financeiros                               Financeiro[]
  historicos                                Historico[]
  propostas                                 Proposta[]
  residuosAnuais                            ResiduoAnual[]
  residuos                                  ResiduoItem[]
}

model Empreendimento {
  id            Int          @id @default(autoincrement())
  apelido       String
  descricao     String
  latitude      Float?
  longitude     Float?
  poligono      String?
  clienteId     Int
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  cnpj          String?
  unidadeSinir  String?
  cep           String?
  municipio     String?
  uf            String?
  rua           String?
  numero        String?
  bairro        String?
  complemento   String?
  ativo         Boolean      @default(true)
  visibilidade  String       @default("publico")
  utmHemisferio String?
  utmX          Float?
  utmY          Float?
  utmZona       Int?
acessos       Acesso[]
    contratos     Contrato[]
    controleDmr   ControleDmr?
    cliente       Cliente      @relation(fields: [clienteId], references: [id])
    historicos    Historico[]
    processos     Processo[]
    propostas     Proposta[]
    sinirConexoes SinirConexao[]
  }

model Orgao {
  id        Int        @id @default(autoincrement())
  nome      String
  sigla     String     @unique
  processos Processo[]
}

model Contrato {
  id                  Int             @id @default(autoincrement())
  servicoProcesso     String
  dataAssinatura      DateTime
  dataValidade        DateTime
  alertaRenovacaoDias Int             @default(60)
  ativo               Boolean         @default(true)
  empreendimentoId    Int?
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  clienteId           Int
  cliente             Cliente         @relation(fields: [clienteId], references: [id])
  empreendimento      Empreendimento? @relation(fields: [empreendimentoId], references: [id])
}

model Processo {
  id               Int                @id @default(autoincrement())
  tipo             String
  orgaoId          Int
  sistema          String
  numProtocolo     String
  status           String             @default("protocolado")
  validade         DateTime?
  empreendimentoId Int
  responsavelId    Int?
  observacoes      String?
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt
  numLicenca       String?
  condicionantes   String?
  dataProtocolo    DateTime?
  dataContato      DateTime?
  alertaDias       Int                @default(30)
  ativo            Boolean            @default(true)
  autorizacaoCorte AutorizacaoCorte?
  documentos       Documento[]
  exigencias       Exigencia[]
  empreendimento   Empreendimento     @relation(fields: [empreendimentoId], references: [id])
  orgao            Orgao              @relation(fields: [orgaoId], references: [id])
  responsavel      Responsavel?       @relation(fields: [responsavelId], references: [id])
  timeline         TimelineProcesso[]
}

model AutorizacaoCorte {
  id                   Int       @id @default(autoincrement())
  processoId           Int       @unique
  quantidadeIndividuos Int?
  compensacaoExigida   Boolean   @default(false)
  tipoCompensacao      String?
  quantidadeMudas      Int?
  areaCompensacaoM2    Float?
  prazoCompensacao     DateTime?
  statusCompensacao    String    @default("pendente")
  comprovante          String?
  exigenciaId          Int?
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
  processo             Processo  @relation(fields: [processoId], references: [id], onDelete: Cascade)
}

model Exigencia {
  id               Int         @id @default(autoincrement())
  descricao        String
  prazo            DateTime
  antecedenciaDias Int         @default(7)
  cumprida         Boolean     @default(false)
  processoId       Int
  criadoEm         DateTime    @default(now())
  atualizadoEm     DateTime    @updatedAt
  ativo            Boolean     @default(true)
  documentos       Documento[]
  processo         Processo    @relation(fields: [processoId], references: [id])
}

model Documento {
  id          Int        @id @default(autoincrement())
  nome        String
  tipo        String
  caminho     String
  tamanho     Int
  processoId  Int?
  exigenciaId Int?
  criadoEm    DateTime   @default(now())
  ativo       Boolean    @default(true)
  clienteId   Int?
  conteudo    Bytes?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id])
  exigencia   Exigencia? @relation(fields: [exigenciaId], references: [id])
  processo    Processo?  @relation(fields: [processoId], references: [id])
}

model TimelineProcesso {
  id         Int      @id @default(autoincrement())
  status     String
  descricao  String?
  criadoEm   DateTime @default(now())
  processoId Int
  usuarioId  Int?
  processo   Processo @relation(fields: [processoId], references: [id])
}

model Responsavel {
  id         Int        @id @default(autoincrement())
  nome       String
  email      String
  telefone   String?
  funcao     String
  cargaHoras Int        @default(0)
  usuarioId  Int?
  criadoEm   DateTime   @default(now())
  processos  Processo[]
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id])
  tarefas    Tarefa[]
}

model Tarefa {
  id             Int         @id @default(autoincrement())
  titulo         String
  descricao      String?
  status         String      @default("pendente")
  prioridade     String      @default("media")
  dataVencimento DateTime?
  responsavelId  Int
  usuarioId      Int
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @updatedAt
  ativo          Boolean     @default(true)
  statusObs      String?
  responsavel    Responsavel @relation(fields: [responsavelId], references: [id])
  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
}

model Financeiro {
  id              Int       @id @default(autoincrement())
  tipoCobranca    String
  valor           Float
  formaPagamento  String
  statusPagamento String    @default("pendente")
  dataVencimento  DateTime?
  dataPagamento   DateTime?
  descricao       String?
  clienteId       Int
  processoId      Int?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  ativo           Boolean   @default(true)
  cliente         Cliente   @relation(fields: [clienteId], references: [id])
}

model LogAuditoria {
  id         Int      @id @default(autoincrement())
  acao       String
  entidade   String
  entidadeId Int
  dados      String?
  usuarioId  Int?
  criadoEm   DateTime @default(now())
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
}

model Alerta {
  id          Int       @id @default(autoincrement())
  titulo      String
  mensagem    String
  tipo        String
  lido        Boolean   @default(false)
  dataDisparo DateTime?
  processoId  Int?
  usuarioId   Int?
  criadoEm    DateTime  @default(now())
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])
}

model EmpresaConfig {
  id           Int     @id @default(autoincrement())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String?
  rua          String?
  numero       String?
  bairro       String?
  complemento  String?
  cep          String?
  municipio    String?
  uf           String?
  telefone     String?
  email        String?
  website      String?
  logo         String?
}

model ResiduoItem {
  id                     Int     @id @default(autoincrement())
  clienteId              Int
  categoria              String
  ordem                  Int
  pontoGeracao           String?
  residuosGerados        String?
  quantificacao          String?
  acondicionamento       String?
  armazenamento          String?
  coletaInterna          String?
  empresaTransporte      String?
  empresaDisposicaoFinal String?
  cliente                Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model ResiduoAnual {
  id                   Int     @id @default(autoincrement())
  clienteId            Int
  categoria            String
  ordem                Int
  pontoGeracao         String?
  residuo              String?
  estadoFisico         String?
  codIbama             String?
  classificacaoResiduo String?
  codigoNbr10004       String?
  codigoConamaLgr      String?
  entrada              String?
  geracaoAnual         String?
  acondicionamento     String?
  transportadora       String?
  tratamento           String?
  destino              String?
  cliente              Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model EmpresaContratada {
  id                        Int     @id @default(autoincrement())
  clienteId                 Int
  ordem                     Int
  nomeFantasia              String?
  razaoSocial               String?
  cnpj                      String?
  numeroDataValidadeLicenca String?
  cliente                   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model ControleDmr {
    id               Int            @id @default(autoincrement())
    empreendimentoId Int            @unique
    ano              Int
    t1Dmr            String         @default("")
    t1Mtr            String         @default("")
    t1EnviadaEm      DateTime?
    t2Dmr            String         @default("")
    t2Mtr            String         @default("")
    t2EnviadaEm      DateTime?
    t3Dmr            String         @default("")
    t3Mtr            String         @default("")
    t3EnviadaEm      DateTime?
    t4Dmr            String         @default("")
    t4Mtr            String         @default("")
    t4EnviadaEm      DateTime?
    criadoEm         DateTime       @default(now())
    atualizadoEm     DateTime       @updatedAt
    empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  }

model SinirConexao {
    id             Int      @id @default(autoincrement())
    nome           String
    cnpj           String
    unidade        String
    empreendimentoId Int?
    token          String?
    modo           String   @default("mock")
    venceEm        DateTime?
    ativo          Boolean  @default(true)
    ultimoUsoEm    DateTime?
    criadoEm       DateTime @default(now())
    atualizadoEm   DateTime @updatedAt
    empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id])
    manifestos     SinirManifesto[]
  }

model SinirManifesto {
  id            Int      @id @default(autoincrement())
  conexaoId     Int
  numero        String
  status        String   @default("EMITIDO")
  certificado   Boolean  @default(false)
  clienteNome   String?
  empreendNome  String?
  transportadorNome String?
  destinadorNome String?
  resumo        String?
  quantidade    Float?
  unidade       String?
  dataExpedicao DateTime?
  dataRecebimento DateTime?
  justificativa String?
  dataCancelamento DateTime?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
  conexao       SinirConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)

  @@unique([conexaoId, numero])
}

model DocumentoGerado {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  templateSlug  String
  dadosSnapshot Json
  caminho       String?
  conteudo      Bytes?
  createdAt     DateTime @default(now())
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model Configuracao {
  id                  Int      @id @default(autoincrement())
  nomeEmpresa         String?
  cnpj                String?
  registroCrq         String?
  registroOrgao       String?
  responsavelNome     String?
  responsavelCpf      String?
  responsavelEndereco String?
  responsavelBairro   String?
  responsavelEmail    String?
  responsavelTelefone String?
  ultimoBackupEm      DateTime?
  atualizadoEm        DateTime @updatedAt
}

model Backup {
  id        Int       @id @default(autoincrement())
  arquivo   String
  tamanho   Int
  origem    String    @default("automatico")
  usuarioId Int?
  conteudo  Bytes?
  criadoEm  DateTime  @default(now())
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])
}

model Historico {
  id               Int             @id @default(autoincrement())
  descricao        String
  anexo            String?
  clienteId        Int?
  empreendimentoId Int?
  usuarioId        Int?
  criadoEm         DateTime        @default(now())
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id])
  usuario          Usuario?        @relation(fields: [usuarioId], references: [id])
}

model Acesso {
  id               Int             @id @default(autoincrement())
  login            String
  senha            String
  descricao        String
  clienteId        Int?
  empreendimentoId Int?
  criadoEm         DateTime        @default(now())
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id])
}

model Proposta {
  id               Int             @id @default(autoincrement())
  titulo           String
  clienteId        Int
  empreendimentoId Int?
  valor            Float?
  status           String          @default("rascunho")
  validadeDias     Int             @default(30)
  servicos         Json?
  observacoes      String?
  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt
  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id])
}

model PropostaServico {
  id           Int      @id @default(autoincrement())
  modeloSlug   String
  numero       Int
  ano          Int
  revisao      Int      @default(0)
  dados        Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model PropostaModelo {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  nome           String
  descricao      String   @default("")
  prefixoArquivo String
  campos         Json     @default("[]")
  template       Bytes?
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}
