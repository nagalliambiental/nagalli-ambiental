# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# old generated prisma (using default output now)
/src/generated/

# sqlite
*.db
*.db-journal

# Rust / Tauri build
/src-tauri/target/
temp_check/

# runtime artifacts (fs efemero na Vercel; bytes ficam no banco)
/public/uploads/
/0

.vercel
